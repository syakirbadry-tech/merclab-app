# Copy this file to ".env" (same folder) on your own computer and fill it in.
# .env is git-ignored: it never goes to GitHub. Never paste the token in chat.
#
# A READ-ONLY Airtable token is enough for the backup:
#   airtable.com/create/tokens -> scope data.records:read -> access: the DMS base only.
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
# Optional: save somewhere else (default E:\The Merc Lab Backups)
# BACKUP_DIR=E:\The Merc Lab Backups
